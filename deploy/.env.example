# Copy to .env (chmod 600) and fill in. Never commit .env.

# Public hostname. Use localhost for a local test (self-signed certificate).
DOMAIN=shuttlecircle.example.com
# Only when a proxy in front already terminates TLS (then Caddy serves plain HTTP):
# SITE_ADDRESS=:80
# HTTP_PORT=8080   # host port for plain HTTP, default 80
# HTTPS_PORT=8443  # host port for HTTPS, default 443

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=

# Requests per minute per client IP on auth, join-request and payment endpoints.
RATE_LIMIT_PER_MIN=10

# Midtrans (optional). Without the server key, gateway payment and top-up return 502;
# wallet and manual credit still work. Dashboard notification URL:
#   https://DOMAIN/api/v1/webhooks/midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=false

# Google sign-in (optional). Authorised redirect URI:
#   https://DOMAIN/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (optional). Without it: in-app notifications only, no password reset.
# Any SMTP relay works. Brevo example (use port 2525 where 587 is blocked):
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=2525  SMTP_USER=<Brevo SMTP login>  SMTP_PASSWORD=<Brevo SMTP key>
# MAIL_FROM must be a sender verified at the relay, for example: ShuttleCircle <you@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# WhatsApp (optional, unofficial gateway: the linked number can be banned by WhatsApp).
# Set all three, start the stack, then link the number by QR code in Admin > WhatsApp.
# COMPOSE_PROFILES=whatsapp
# WAHA_URL=http://waha:3000
# WAHA_API_KEY=            # openssl rand -hex 32

# Set these to pull prebuilt images instead of building on this machine.
# API_IMAGE=ghcr.io/OWNER/shuttlecircle-api:TAG
# WEB_IMAGE=ghcr.io/OWNER/shuttlecircle-web:TAG
