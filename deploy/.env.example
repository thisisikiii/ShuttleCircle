# Copy to .env (chmod 600) and fill in. Never commit .env.

# Public hostname. Use localhost for a local test (self-signed certificate).
DOMAIN=shuttlecircle.example.com

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=

# Requests per minute per client IP on auth, join-request and payment endpoints.
RATE_LIMIT_PER_MIN=10

# Midtrans (optional). Without the server key, gateway payment and top-up return 502;
# wallet and manual credit still work. Dashboard notification URL:
#   https://DOMAIN/api/v1/webhooks/midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=false

# Google sign-in (optional). Authorised redirect URI:
#   https://DOMAIN/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (optional). Without it: in-app notifications only, no password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Set these to pull prebuilt images instead of building on this machine.
# API_IMAGE=ghcr.io/OWNER/shuttlecircle-api:TAG
# WEB_IMAGE=ghcr.io/OWNER/shuttlecircle-web:TAG
